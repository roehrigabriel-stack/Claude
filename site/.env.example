# Copie ce fichier en .env et remplis-le. Ne commite jamais .env.

# Cle API Anthropic (https://platform.claude.com, rubrique API Keys)
ANTHROPIC_API_KEY=

# Optionnel : mot de passe demande aux visiteurs (recommande si le site est en ligne)
SITE_PASSWORD=

# Optionnel : nombre maximum de demandes par jour et par adresse IP (defaut 100)
DAILY_LIMIT=100

# Optionnel : modele Claude (defaut claude-opus-5-5 ; claude-haiku-5-5 est bien moins cher)
CLAUDE_MODEL=claude-opus-5-5
